    "diskSpace": "500MB"
  },
  "dependencies": {
    "@h4shed/skill-syncpulse": "^1.0.0",
    "@h4shed/skill-syncpulse-hub": "^1.0.0",
    "@h4shed/skill-syncpulse-workflows": "^1.0.0",
    "@h4shed/mcp-core": "^1.0.24"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/node": "^20.10.6"
  },
  "entry": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "categories": [
    "productivity",
    "automation",
    "orchestration",
    "ai-agents"
  ],
  "icon": "🔄",
  "color": "#6366f1",
  "pricing": {
    "model": "free",
    "features": {
      "free": {
        "workflows": "unlimited",
        "agents": "up to 5",
        "apiCalls": "1000/month",
        "storage": "1GB"
      }
    }
  },
  "documentation": {
    "homepage": "https://github.com/fused-gaming/syncpulse#readme",
    "gettingStarted": "docs/GETTING_STARTED.md",
    "api": "docs/API.md",
    "examples": "docs/EXAMPLES.md",
    "troubleshooting": "docs/TROUBLESHOOTING.md"
  },
  "support": {
    "issues": "https://github.com/fused-gaming/syncpulse/issues",
    "discussions": "https://github.com/fused-gaming/syncpulse/discussions",
    "email": "support@vln.gg"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "metadata": {
    "installCount": 0,
    "rating": 5.0,
    "reviews": 0,
    "verified": true,
    "official": true,
    "compatible": {
      "nodeVersions": ["20.x", "22.x"],
      "platforms": ["linux", "macos", "windows"],
      "claude": ["sonnet-5", "opus-5", "haiku-4.5"]
    }
  },
  "changelog": {
    "url": "https://github.com/fused-gaming/syncpulse/blob/main/CHANGELOG.md",
    "latest": "1.0.0"
  },
  "security": {
    "permissions": [
      "read:workflows",
      "write:workflows",
      "read:agents",
      "write:agents",
      "send:email"
