{
  "name": "syncpulse-orchestrator",
  "displayName": "SyncPulse Orchestrator",
  "version": "1.0.0",
  "description": "Multi-agent orchestration and coordination for autonomous workflows with SyncPulse",
  "author": {
    "name": "Fused Gaming",
    "email": "support@vln.gg",
    "url": "https://github.com/fused-gaming/syncpulse"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fused-gaming/syncpulse.git",
    "directory": "plugins/syncpulse-claude-plugin"
  },
  "license": "Apache-2.0",
  "keywords": [
    "orchestration",
    "multi-agent",
    "workflow",
    "coordination",
    "mcp",
    "automation"
